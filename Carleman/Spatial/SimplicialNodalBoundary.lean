module

public import Carleman.Spatial.SimplicialNodalOperator

/-! Exact preservation of zero boundary values on a boundary-fitted mesh,
and continuity of the zero extension. These are pointwise statements;
zero Sobolev trace and H¹₀ membership are not assumed or concluded. -/
@[expose] public noncomputable section
open MeasureTheory Set
namespace Carleman.SimplicialPartition
variable {d : ℕ} {ι : Type*} {S : Set (SpatialCoordinates d)}
  (M : Carleman.SimplicialPartition S ι)

/-- Every part of a cell on the boundary is generated by its boundary nodes. -/
def BoundaryFitted : Prop :=
  ∀ i, M.cell i ∩ frontier S ⊆ convexHull ℝ (Set.range (M.simplex i).points ∩ frontier S)

theorem localNodal_zero_on_boundary (hB : M.BoundaryFitted)
    (f : SpatialCoordinates d → ℝ)
    (hf : ∀ i k, (M.simplex i).points k ∈ frontier S → f ((M.simplex i).points k) = 0)
    (i : ι) {x : SpatialCoordinates d} (hx : x ∈ M.cell i) (hb : x ∈ frontier S) :
    M.localNodal f i x = 0 := by
  have he : (Set.range (M.simplex i).points ∩ frontier S).EqOn
      (M.localNodal f i) (0 : SpatialCoordinates d →ᵃ[ℝ] ℝ) := by
    rintro _ ⟨⟨k,rfl⟩,hk⟩
    rw [M.localNodal_vertex]
    exact hf i k hk
  exact AffineMap.eqOn_affineSpan he ((convexHull_subset_affineSpan _) (hB i ⟨hx,hb⟩))

theorem nodalFunction_zero_outside (f : SpatialCoordinates d → ℝ)
    {x : SpatialCoordinates d} (hx : x ∉ closure S) : M.nodalFunction f x = 0 := by
  classical
  have hn : ¬∃ i, x ∈ M.cell i := by
    rintro ⟨i,hi⟩
    exact hx (M.inside i hi)
  exact dite_eq_right hn

variable [Fintype ι]

theorem nodalFunction_zero_on_boundary (hM : M.FaceMatching) (hB : M.BoundaryFitted)
    (f : SpatialCoordinates d → ℝ)
    (hf : ∀ i k, (M.simplex i).points k ∈ frontier S → f ((M.simplex i).points k) = 0)
    {x : SpatialCoordinates d} (hx : x ∈ frontier S) : M.nodalFunction f x = 0 := by
  have hc := frontier_subset_closure hx
  rw [← M.cells_union] at hc
  obtain ⟨i,hi⟩ := mem_iUnion.mp hc
  rw [M.nodalFunction_on_cell hM f i hi]
  exact M.localNodal_zero_on_boundary hB f hf i hi hx

theorem nodalFunction_zero_on_compl (hS : IsOpen S) (hM : M.FaceMatching) (hB : M.BoundaryFitted)
    (f : SpatialCoordinates d → ℝ)
    (hf : ∀ i k, (M.simplex i).points k ∈ frontier S → f ((M.simplex i).points k) = 0)
    {x : SpatialCoordinates d} (hx : x ∉ S) : M.nodalFunction f x = 0 := by
  by_cases hc : x ∈ closure S
  · apply M.nodalFunction_zero_on_boundary hM hB f hf
    rw [hS.frontier_eq]
    exact ⟨hc,hx⟩
  · exact M.nodalFunction_zero_outside f hc

theorem nodalFunction_continuous_of_boundary (hS : IsOpen S) (hM : M.FaceMatching)
    (hB : M.BoundaryFitted) (f : SpatialCoordinates d → ℝ)
    (hf : ∀ i k, (M.simplex i).points k ∈ frontier S → f ((M.simplex i).points k) = 0) :
    Continuous (M.nodalFunction f) := by
  have hc : ContinuousOn (M.nodalFunction f) Sᶜ :=
    continuousOn_const.congr (fun _ hx => M.nodalFunction_zero_on_compl hS hM hB f hf hx)
  have hh := (M.nodalFunction_continuousOn hM f).union_of_isClosed hc isClosed_closure hS.isClosed_compl
  have he : closure S ∪ Sᶜ = Set.univ := by
    apply Set.eq_univ_of_forall
    intro x
    by_cases hx : x ∈ S
    · exact Or.inl (subset_closure hx)
    · exact Or.inr hx
  rw [he] at hh
  exact continuousOn_univ.mp hh

theorem nodalFunction_hasCompactSupport (f : SpatialCoordinates d → ℝ) :
    HasCompactSupport (M.nodalFunction f) := by
  have hc : IsCompact (closure S) := by
    rw [← M.cells_union]
    exact isCompact_iUnion (fun i => simplicialCell_compact (M.simplex i).points)
  exact HasCompactSupport.intro' hc isClosed_closure (fun _ hx => M.nodalFunction_zero_outside f hx)

end Carleman.SimplicialPartition
